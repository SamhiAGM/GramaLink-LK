<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lk.gramalink.client.AdminDashboardController" styleClass="citizen-root">
    <left>
        <VBox spacing="10" prefWidth="215" minWidth="190" styleClass="sidebar">
            <Label text="GL" styleClass="brand-mark"/>
            <Label text="GramaLink LK" styleClass="brand-name"/>
            <Label text="ADMINISTRATOR WORKSPACE" styleClass="sidebar-caption"/>
            <Separator/>
            <Button fx:id="navOverview" text="Overview" onAction="#showOverview" maxWidth="Infinity" styleClass="nav-button"/>
            <Button fx:id="navClients" text="Online Clients" onAction="#showClients" maxWidth="Infinity" styleClass="nav-button"/>
            <Button fx:id="navUsers" text="User Management" onAction="#showUsers" maxWidth="Infinity" styleClass="nav-button"/>
            <Button fx:id="navOffices" text="Office Management" onAction="#showOffices" maxWidth="Infinity" styleClass="nav-button"/>
            <Button fx:id="navStatistics" text="Request Statistics" onAction="#showStatistics" maxWidth="Infinity" styleClass="nav-button"/>
            <Button fx:id="navAudit" text="Audit Logs" onAction="#showAudit" maxWidth="Infinity" styleClass="nav-button"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Clear oversight.&#10;Accountable administration." wrapText="true" styleClass="sidebar-caption"/>
            <Button fx:id="signOutButton" text="Sign out" onAction="#signOut" maxWidth="Infinity" styleClass="nav-button"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="16" styleClass="main-area">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="SYSTEM OVERSIGHT · DEMO MANAGEMENT" styleClass="eyebrow"/>
                    <Label text="Administrator dashboard" styleClass="page-title"/>
                    <Label fx:id="administratorName" text="Administrator authorization required" styleClass="muted"/>
                </VBox>
                <Circle fx:id="connectionDot" radius="5" styleClass="offline"/>
                <Label fx:id="connectionLabel" text="Not connected"/>
            </HBox>
            <Label fx:id="feedback" text="Administrative data and submissions await server support. Table rows, statistics and audit entries change only from authoritative server data."
                   wrapText="true" maxWidth="Infinity" styleClass="notice"/>
            <HBox fx:id="activityRow" spacing="10" alignment="CENTER_LEFT">
                <ProgressIndicator fx:id="busyIndicator" visible="false" prefWidth="20" prefHeight="20"/>
                <Label fx:id="activityLabel" styleClass="muted"/>
            </HBox>
            <VBox fx:id="workspace" VBox.vgrow="ALWAYS">
                <TabPane fx:id="sections" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <tabs>
                        <Tab text="Overview">
                            <ScrollPane fitToWidth="true">
                                <VBox spacing="20" styleClass="section">
                                    <Label text="System overview" styleClass="section-title"/>
                                    <Label text="Backend-provided totals for connected clients, demo accounts, offices and requests." wrapText="true" styleClass="muted"/>
                                    <HBox spacing="12">
                                        <VBox spacing="10" styleClass="metric-card" HBox.hgrow="ALWAYS"><Label text="CONNECTED CLIENTS" styleClass="eyebrow"/><Label fx:id="clientsCount" text="—" styleClass="metric"/></VBox>
                                        <VBox spacing="10" styleClass="metric-card" HBox.hgrow="ALWAYS"><Label text="DEMO USERS" styleClass="eyebrow"/><Label fx:id="usersCount" text="—" styleClass="metric"/></VBox>
                                        <VBox spacing="10" styleClass="metric-card" HBox.hgrow="ALWAYS"><Label text="OFFICES" styleClass="eyebrow"/><Label fx:id="officesCount" text="—" styleClass="metric"/></VBox>
                                        <VBox spacing="10" styleClass="metric-card" HBox.hgrow="ALWAYS"><Label text="REQUESTS" styleClass="eyebrow"/><Label fx:id="requestsCount" text="—" styleClass="metric"/></VBox>
                                    </HBox>
                                    <Label fx:id="overviewAsOf" text="Server overview has not been loaded." styleClass="muted"/>
                                    <VBox spacing="14" styleClass="card">
                                        <Label text="Explore your administrative workspace" styleClass="section-title"/>
                                        <Label text="Inspect available sessions, manage server-identified demo records and review recorded activities. Unknown values remain unknown; table rows are not used as global totals." wrapText="true" styleClass="muted"/>
                                        <FlowPane hgap="10" vgap="10">
                                            <Button text="View clients" onAction="#showClients"/>
                                            <Button text="Manage demo users" onAction="#showUsers"/>
                                            <Button text="Review audit logs" onAction="#showAudit"/>
                                            <Button text="Refresh from server" disable="true"/>
                                        </FlowPane>
                                    </VBox>
                                </VBox>
                            </ScrollPane>
                        </Tab>
                        <Tab text="Online Clients">
                            <VBox spacing="14" styleClass="section">
                                <Label text="Online clients" styleClass="section-title"/>
                                <Label text="Connection and session information appears only when supplied by the administrative server. Session references must never contain authentication tokens." wrapText="true" styleClass="muted"/>
                                <TableView fx:id="clientsTable" VBox.vgrow="ALWAYS"><columns>
                                    <TableColumn fx:id="connectionColumn" text="Connection" prefWidth="125"/><TableColumn fx:id="clientUserColumn" text="User" prefWidth="135"/>
                                    <TableColumn fx:id="clientRoleColumn" text="Role" prefWidth="110"/><TableColumn fx:id="clientOfficeColumn" text="Office" prefWidth="120"/>
                                    <TableColumn fx:id="addressColumn" text="Remote address" prefWidth="145"/><TableColumn fx:id="sessionColumn" text="Session reference" prefWidth="150"/>
                                    <TableColumn fx:id="connectedColumn" text="Connected (Sri Lanka)" prefWidth="175"/><TableColumn fx:id="lastActivityColumn" text="Last activity (server)" prefWidth="175"/>
                                </columns></TableView>
                            </VBox>
                        </Tab>
                        <Tab text="User Management">
                            <ScrollPane fx:id="usersScroll" fitToWidth="true">
                                <VBox spacing="16" styleClass="section">
                                    <Label text="Demo user management" styleClass="section-title"/>
                                    <Label text="Only accounts explicitly identified by the server as demo records may be changed. Other listed accounts are read only." wrapText="true" styleClass="muted"/>
                                    <TableView fx:id="usersTable" prefHeight="220"><columns>
                                        <TableColumn fx:id="userIdColumn" text="User ID" prefWidth="140"/><TableColumn fx:id="usernameColumn" text="Username" prefWidth="150"/>
                                        <TableColumn fx:id="displayNameColumn" text="Display name" prefWidth="170"/><TableColumn fx:id="roleColumn" text="Role" prefWidth="160"/>
                                        <TableColumn fx:id="userOfficeColumn" text="Office reference" prefWidth="170"/><TableColumn fx:id="userStateColumn" text="State" prefWidth="140"/>
                                        <TableColumn fx:id="demoUserColumn" text="Management scope" prefWidth="190"/>
                                    </columns></TableView>
                                    <VBox fx:id="userForm" spacing="12" styleClass="card">
                                        <Label text="Demo account draft" styleClass="subheading"/>
                                        <Label text="Username"/><TextField fx:id="username" promptText="Demo username" accessibleText="Demo username"/>
                                        <Label text="Display name"/><TextField fx:id="userDisplayName" promptText="Demo display name" accessibleText="Demo display name"/>
                                        <Label text="Role from server catalogue"/><ComboBox fx:id="userRole" promptText="Awaiting backend role catalogue" maxWidth="Infinity" accessibleText="Demo user role"/>
                                        <Label text="Office (optional, subject to backend rules)"/>
                                        <HBox spacing="10"><ComboBox fx:id="userOffice" promptText="No office selected" maxWidth="Infinity" HBox.hgrow="ALWAYS" accessibleText="Demo user office"/><Button text="No office" onAction="#clearUserOffice"/></HBox>
                                        <Label text="Change reason (required to disable)"/><TextArea fx:id="userReason" prefRowCount="2" wrapText="true" accessibleText="Demo account change reason"/>
                                        <HBox spacing="10"><ComboBox fx:id="userIntent" maxWidth="Infinity" HBox.hgrow="ALWAYS"/><Button fx:id="checkUserButton" text="Check user fields" onAction="#checkUser" disable="true"/><Button text="Clear draft" onAction="#clearUserForm"/></HBox>
                                        <FlowPane hgap="10" vgap="10">
                                            <Button fx:id="createUserButton" text="Create demo user" onAction="#createUser" disable="true" styleClass="primary-button"/>
                                            <Button fx:id="updateUserButton" text="Update selected demo" onAction="#updateUser" disable="true"/>
                                            <Button fx:id="disableUserButton" text="Disable selected demo" onAction="#disableUser" disable="true" styleClass="danger-button"/>
                                        </FlowPane>
                                        <Label text="No password or credential provisioning is simulated. Submissions require a coordinated administrative backend contract." wrapText="true" styleClass="muted"/>
                                    </VBox>
                                </VBox>
                            </ScrollPane>
                        </Tab>
                        <Tab text="Office Management">
                            <ScrollPane fx:id="officesScroll" fitToWidth="true">
                                <VBox spacing="16" styleClass="section">
                                    <Label text="GN and DS office management" styleClass="section-title"/>
                                    <Label text="Office types and codes must come from the server catalogue. Only server-identified demo offices can be edited here." wrapText="true" styleClass="muted"/>
                                    <TableView fx:id="officesTable" prefHeight="220"><columns>
                                        <TableColumn fx:id="officeIdColumn" text="Office ID" prefWidth="170"/><TableColumn fx:id="officeNameColumn" text="Office name" prefWidth="215"/>
                                        <TableColumn fx:id="officeKindColumn" text="Type" prefWidth="170"/><TableColumn fx:id="officeAreaColumn" text="Area / division" prefWidth="180"/>
                                        <TableColumn fx:id="officeStateColumn" text="State" prefWidth="150"/><TableColumn fx:id="demoOfficeColumn" text="Management scope" prefWidth="190"/>
                                    </columns></TableView>
                                    <VBox fx:id="officeForm" spacing="12" styleClass="card">
                                        <Label text="Demo office draft" styleClass="subheading"/>
                                        <Label text="Office name"/><TextField fx:id="officeName" promptText="Demo office name" accessibleText="Demo office name"/>
                                        <Label text="Type from server catalogue"/><ComboBox fx:id="officeKind" promptText="Awaiting GN / DS type catalogue" maxWidth="Infinity" accessibleText="Demo office type"/>
                                        <Label text="Area or division"/><TextField fx:id="officeArea" promptText="Office area or division" accessibleText="Demo office area"/>
                                        <Label text="Change reason (required to archive)"/><TextArea fx:id="officeReason" prefRowCount="2" wrapText="true" accessibleText="Demo office change reason"/>
                                        <HBox spacing="10"><ComboBox fx:id="officeIntent" maxWidth="Infinity" HBox.hgrow="ALWAYS"/><Button fx:id="checkOfficeButton" text="Check office fields" onAction="#checkOffice" disable="true"/><Button text="Clear draft" onAction="#clearOfficeForm"/></HBox>
                                        <FlowPane hgap="10" vgap="10">
                                            <Button fx:id="createOfficeButton" text="Create demo office" onAction="#createOffice" disable="true" styleClass="primary-button"/>
                                            <Button fx:id="updateOfficeButton" text="Update selected demo" onAction="#updateOffice" disable="true"/>
                                            <Button fx:id="archiveOfficeButton" text="Archive selected demo" onAction="#archiveOffice" disable="true" styleClass="danger-button"/>
                                        </FlowPane>
                                        <Label text="No administrative change or audit entry is generated locally. Live office services remain pending." wrapText="true" styleClass="muted"/>
                                    </VBox>
                                </VBox>
                            </ScrollPane>
                        </Tab>
                        <Tab text="Request Statistics">
                            <VBox spacing="14" styleClass="section">
                                <Label text="Request statistics" styleClass="section-title"/>
                                <Label text="Status labels and counts are supplied by the backend. Partial results are not used to invent global totals or percentages." wrapText="true" styleClass="muted"/>
                                <Label fx:id="statisticsTotal" text="Backend total: —" styleClass="subheading"/>
                                <Label fx:id="statisticsScope" text="Scope: Not supplied"/><Label fx:id="statisticsAsOf" text="Statistics have not been loaded." styleClass="muted"/>
                                <TableView fx:id="statisticsTable" VBox.vgrow="ALWAYS"><columns>
                                    <TableColumn fx:id="requestStatusColumn" text="Backend-provided status" prefWidth="480"/><TableColumn fx:id="requestCountColumn" text="Backend-provided count" prefWidth="300"/>
                                </columns></TableView>
                            </VBox>
                        </Tab>
                        <Tab text="Audit Logs">
                            <VBox spacing="14" styleClass="section">
                                <Label text="Recorded audit activity" styleClass="section-title"/>
                                <Label text="Read-only backend records, newest timestamp first. Local actions, ACKs and validation checks do not create audit entries." wrapText="true" styleClass="muted"/>
                                <TableView fx:id="auditTable" VBox.vgrow="ALWAYS"><columns>
                                    <TableColumn fx:id="auditDateColumn" text="Timestamp (Sri Lanka)" prefWidth="190"/><TableColumn fx:id="auditUserColumn" text="User" prefWidth="170"/>
                                    <TableColumn fx:id="auditActivityColumn" text="Recorded activity" prefWidth="320"/><TableColumn fx:id="auditTargetColumn" text="Target" prefWidth="190"/>
                                    <TableColumn fx:id="auditOutcomeColumn" text="Recorded outcome" prefWidth="190"/>
                                </columns></TableView>
                            </VBox>
                        </Tab>
                    </tabs>
                </TabPane>
            </VBox>
        </VBox>
    </center>
</BorderPane>
